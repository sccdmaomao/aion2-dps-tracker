<Window x:Class="LocalDps.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Local DPS Tracker 0.9.3" Width="580" Height="790" MinWidth="460" MinHeight="430" Background="#0C111B" Foreground="#E8EDF6" FontFamily="Segoe UI">
 <Window.Resources>
  <Style TargetType="ScrollBar"><Setter Property="Background" Value="#141D2C"/><Setter Property="Width" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}"><Track.DecreaseRepeatButton><RepeatButton x:Name="Before" Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Background="#3C4B62" CornerRadius="4" Margin="2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#688398"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton x:Name="After" Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="Before" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/><Setter TargetName="After" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/></Trigger></Style.Triggers></Style>
  <SolidColorBrush x:Key="Muted" Color="#8290A8"/>
  <Style TargetType="TextBlock"><Setter Property="Margin" Value="0,2"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#202A3B"/><Setter Property="Foreground" Value="#E8EDF6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#8EA9D2"/><Setter TargetName="Chrome" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#E8EDF6"/><Setter Property="Padding" Value="12,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#28364C"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#223F44"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#E8EDF6"/><Setter Property="Background" Value="#192232"/><Setter Property="MinHeight" Value="38"/><Setter Property="FontSize" Value="13"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Box" Background="#192232" BorderBrush="#2C384D" BorderThickness="1" CornerRadius="8"><Path Data="M 0,0 L 4,4 L 8,0" Stroke="#91A1BA" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#608B92"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" IsHitTestVisible="False" Margin="12,0,36,0" VerticalAlignment="Center"/>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="#172132" BorderBrush="#334259" BorderThickness="1" CornerRadius="8" Padding="5" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,5,0,0"><ScrollViewer MaxHeight="250" CanContentScroll="True"><ItemsPresenter/></ScrollViewer></Border></Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Background" Value="#223344"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#192232"/><Setter Property="Foreground" Value="#E8EDF6"/><Setter Property="BorderBrush" Value="#334259"/><Setter Property="Padding" Value="8"/><Setter Property="CaretBrush" Value="#71E2C1"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#B4C0D3"/><Setter Property="Margin" Value="0,8,16,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><Border x:Name="Box" Width="14" Height="14" Background="#192232" BorderBrush="#50617B" BorderThickness="1" CornerRadius="3" VerticalAlignment="Center"><Path x:Name="Mark" Data="M 2,6 L 5,9 L 10,3" Stroke="#0D2824" StrokeThickness="1.5" Visibility="Collapsed"/></Border><ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#71E2C1"/><Setter TargetName="Box" Property="BorderBrush" Value="#71E2C1"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#71E2C1"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#E8EDF6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Expander"><Setter Property="Foreground" Value="#B4C0D3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel><ToggleButton x:Name="Toggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalContentAlignment="Left" Background="Transparent" Foreground="{TemplateBinding Foreground}" BorderThickness="0" Padding="0,8" Cursor="Hand"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><Path x:Name="Arrow" Data="M 0,0 L 4,4 L 0,8" Stroke="#8290A8" StrokeThickness="1.5" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/><ContentPresenter Grid.Column="1" Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="0,8,0,0"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#141D2C"/><Setter Property="Foreground" Value="#8290A8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="16,12"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Foreground" Value="#E8EDF6"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#20363F"/><Setter Property="Foreground" Value="#E8EDF6"/></Trigger></Style.Triggers></Style>
  <Style TargetType="DataGridRow"><Setter Property="MinHeight" Value="68"/><Setter Property="Background" Value="#141D2C"/><Setter Property="Foreground" Value="#E8EDF6"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1B293C"/></Trigger></Style.Triggers></Style>
  <Style x:Key="ShareBar" TargetType="ProgressBar"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track" Height="3" ClipToBounds="True"><Border Background="#263449" CornerRadius="1.5"/><Decorator x:Name="PART_Indicator" HorizontalAlignment="Left"><Border Background="#4B8D87" CornerRadius="1.5"/></Decorator></Grid></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Margin="22,18,22,16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel LastChildFill="False" Margin="0,0,0,20">
   <StackPanel DockPanel.Dock="Left"><TextBlock Text="Local DPS Tracker" FontSize="24" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="1,4,0,0"><Ellipse Width="5" Height="5" Fill="#71E2C1" Margin="0,0,6,0"/><TextBlock Text="LOCAL ONLY" Foreground="#8290A8" FontSize="9" FontWeight="SemiBold"/></StackPanel></StackPanel>
   <Button DockPanel.Dock="Right" x:Name="StartButton" Content="Start capturing" Click="StartClick" Background="#71E2C1" Foreground="#0D2824" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0" Padding="16,11"/>
  </DockPanel>
  <StackPanel Grid.Row="1">
   <Border Background="#141D2C" CornerRadius="10" Padding="14,9" BorderBrush="#233047" BorderThickness="1" Margin="0,0,0,8"><StackPanel>
    <DockPanel><Button DockPanel.Dock="Right" x:Name="ChangeCharacterButton" Content="Change" Click="ChangeCharacterClick" Padding="9,5" Margin="8,0,0,0" Visibility="Collapsed"/><TextBlock x:Name="CharacterNameText" Text="Detect your character automatically" Foreground="#B4C0D3" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
    <StackPanel x:Name="CharacterEntry" Margin="0,8,0,0">
     <DockPanel><Button DockPanel.Dock="Right" x:Name="CancelCharacterButton" Content="Cancel" Click="CancelCharacterClick" Padding="10,8" Margin="8,0,0,0" Visibility="Collapsed"/><Button DockPanel.Dock="Right" Content="Use name" Click="ApplyPeopleClick" Padding="12,8" Margin="8,0,0,0"/><Grid><TextBox x:Name="SelfNameBox" MinWidth="100" ToolTip="Your exact character name. Optional when automatic detection succeeds."/><TextBlock Text="Character name (optional)" Foreground="#687990" Margin="9,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SelfNameBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel>
     <TextBlock x:Name="CharacterHelp" Text="Start capturing, then teleport once to detect your character name. Or enter your name above." FontSize="10" Foreground="#8290A8" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>
   </StackPanel></Border>
  <Border Background="#141D2C" CornerRadius="10" Padding="14,11" BorderBrush="#233047" BorderThickness="1"><DockPanel><TextBlock DockPanel.Dock="Left" Text="TARGET" FontSize="10" FontWeight="SemiBold" Foreground="#8290A8" VerticalAlignment="Center" Margin="0,0,18,0"/><ComboBox x:Name="TargetBox" DisplayMemberPath="Label" ToolTip="Select a target. Defeated means a recent positive-to-zero HP transition was observed. The whole party continues to be captured."/></DockPanel></Border>
  </StackPanel>
  <StackPanel Grid.Row="2" Margin="2,10,0,10"><TextBlock x:Name="EncounterTime" Text="Waiting for combat · 00:00:00" FontSize="16" FontWeight="SemiBold" Foreground="#E8EDF6"/><TextBlock x:Name="Totals" Foreground="#8290A8" FontSize="11"/></StackPanel>
  <Border Grid.Row="3" Background="#141D2C" CornerRadius="10" BorderBrush="#233047" BorderThickness="1" ClipToBounds="True"><DataGrid x:Name="PlayersGrid" IsReadOnly="True" AutoGenerateColumns="False" Background="Transparent" Foreground="#E8EDF6" HeadersVisibility="Column" CanUserAddRows="False" GridLinesVisibility="None" BorderThickness="0" HorizontalScrollBarVisibility="Auto" RowHeaderWidth="0" SelectionMode="Single">
   <DataGrid.Columns>
    <DataGridTemplateColumn Header="PARTY" Width="*" MinWidth="165"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="16,6,20,6"><TextBlock Text="{Binding Actor}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Status}" FontSize="10" Foreground="#8290A8" Margin="0,3,0,8"/><ProgressBar Style="{StaticResource ShareBar}" Maximum="100" Value="{Binding Share}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn Header="DPS / DAMAGE SHARE" Width="155"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,18,0"><TextBlock Text="{Binding DpsText}" FontFamily="Cascadia Mono,Consolas" FontSize="23" FontWeight="SemiBold" Foreground="#71E2C1" HorizontalAlignment="Right"/><TextBlock Text="{Binding ShareText}" FontSize="11" Foreground="#8290A8" HorizontalAlignment="Right" ToolTip="Your damage divided by all captured party damage for the selected encounter and target."/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn x:Name="DamageColumn" Header="DAMAGE" Binding="{Binding Damage, StringFormat=N0}" Width="110" Visibility="Collapsed"/>
    <DataGridTextColumn x:Name="HitsColumn" Header="HITS" Binding="{Binding Hits}" Width="65" Visibility="Collapsed"/>
    <DataGridTextColumn x:Name="ShareColumn" Header="SHARE %" Binding="{Binding Share, StringFormat=N1}" Width="80" Visibility="Collapsed"/>
   </DataGrid.Columns>
  </DataGrid></Border>
  <StackPanel Grid.Row="4" Margin="2,12,2,4"><TextBlock x:Name="StatusText" Text="Enter Aion 2, then start capturing." FontSize="11" TextWrapping="Wrap" Foreground="#B4C0D3"/><TextBlock x:Name="IdentityStatus" TextWrapping="Wrap" FontSize="10" Foreground="#8290A8"/></StackPanel>
  <Expander Grid.Row="5" Header="More" Margin="2,2,2,0"><ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"><StackPanel>
   <ComboBox x:Name="EncounterBox" DisplayMemberPath="Label" Margin="0,0,0,8" ToolTip="Latest follows new encounters automatically. Select an earlier encounter to review it."/><WrapPanel Margin="0,0,0,4"><Button Content="Clear encounters" Click="ResetClick"/><Button Content="Save encounter" Click="SaveClick"/></WrapPanel>
   <WrapPanel><CheckBox x:Name="OnTop" Content="Keep on top" Checked="TopChanged" Unchecked="TopChanged"/><CheckBox Content="Show damage, hits and share" Checked="DetailsChanged" Unchecked="DetailsChanged"/></WrapPanel>
   <TextBlock Text="All party members are captured. Target selection only changes the display." TextWrapping="Wrap" FontSize="11" Foreground="#8290A8"/>
   <Expander Header="Troubleshooting" Margin="0,6,0,0"><StackPanel>
    <TextBlock x:Name="AutoDetails" TextWrapping="Wrap" Foreground="#8290A8"/>
    <TextBlock Text="Periodic recovery supports four teammates. Names are remembered locally. Late identity mappings can recover recent hits; unsupported roster variants remain excluded." TextWrapping="Wrap" Foreground="#8290A8"/>
    <TextBlock Text="Observed names (nearby players stay excluded)" Foreground="#8290A8"/>
    <ScrollViewer MaxHeight="100"><TextBlock x:Name="EntityNamesText" TextWrapping="Wrap" Foreground="#8290A8"/></ScrollViewer>
    <TextBlock x:Name="DiagnosticsText" FontSize="11" Foreground="#8290A8" TextWrapping="Wrap"/>
    <WrapPanel Margin="0,8"><Button Content="Save diagnostic recording" Click="SaveDiagnosticsClick" ToolTip="Save up to the last two minutes of raw game traffic locally for troubleshooting."/><Button Content="Replay recording" Click="ReplayClick"/><Button Content="Demo" Click="DemoClick"/><ComboBox x:Name="FramingBox" Width="145"/></WrapPanel>
    <TextBlock FontSize="11" Foreground="#8290A8" TextWrapping="Wrap" Text="Encounters start on party damage and end after 15 seconds without damage. The timer includes that ending grace period. All targets share the encounter clock; DPS uses a 1-second minimum. The latest 50 encounters stay in memory. Exact damage accuracy, pets and relay support remain provisional. Version 0.9.3."/>
   </StackPanel></Expander>
  </StackPanel></ScrollViewer></Expander>
 </Grid>
</Window>
