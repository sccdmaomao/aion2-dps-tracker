<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>LocalDpsTracker</AssemblyName>
    <RootNamespace>LocalDps</RootNamespace>
    <Title>Local DPS Tracker</Title>
    <Product>Local DPS Tracker</Product>
    <Description>Local-only party damage and encounter tracking for Aion 2.</Description>
    <Version>1.2.0</Version>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup><EmbeddedResource Include="Data/skill-rules.json" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Data/target-names.json" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets/Classes/*.png" LogicalName="LocalDps.ClassIcons.%(Filename)%(Extension)" /></ItemGroup>
</Project>
